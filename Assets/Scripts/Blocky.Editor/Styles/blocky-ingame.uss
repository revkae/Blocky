/* Chrome for BlockyInGamePanel's Scratch-like layout. Deliberately neutral (grays/off-white) — the only
   saturated color in the whole workspace is each block's category tint (blocky-base.uss / blocky-*.uss),
   plus the green Go button, so the UI reads as "colorful where it matters" rather than noisy. */

.blocky-ingame-root {
    background-color: rgb(230, 231, 236);
}

/* Responsive top bar: title and Go keep their size; the status text takes what's left and ends in "…"
   instead of pushing the Go button out of the panel when the workspace is narrow. */
.blocky-ingame-topbar {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding: 0 10px;
    overflow: hidden;
    background-color: rgb(64, 68, 82);
}

.blocky-ingame-title {
    flex-shrink: 0;
    color: rgb(235, 235, 240);
    -unity-font-style: bold;
    margin-right: 12px;
}

.blocky-ingame-status {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: rgb(190, 192, 200);
    -unity-text-align: middle-left;
}

.blocky-ingame-go-button {
    flex-shrink: 0;
    background-color: rgb(76, 191, 86);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-radius: 16px;
    border-width: 0;
    padding: 4px 18px;
    margin-left: 8px;
}

.blocky-ingame-go-button:hover {
    background-color: rgb(92, 209, 102);
}

.blocky-ingame-body {
    flex-direction: row;
    flex-grow: 1;
}

.blocky-ingame-tabrail {
    width: 64px;
    background-color: rgb(64, 68, 82);
}

/* Scratch-style tab: a colored dot with the category name underneath. */
.blocky-ingame-tab {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 54px;
    margin: 2px 0;
    padding: 4px 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.blocky-ingame-tab:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.blocky-ingame-tab__dot {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.6);
}

.blocky-ingame-tab__label {
    margin-top: 3px;
    font-size: 10px;
    white-space: nowrap;
    color: rgb(215, 217, 225);
    -unity-text-align: middle-center;
}

/* Shrinks with a narrow workspace instead of squeezing the table to nothing. */
.blocky-ingame-palette {
    flex-basis: 250px;
    flex-shrink: 1;
    min-width: 140px;
    background-color: rgb(246, 247, 250);
    border-right-width: 1px;
    border-right-color: rgb(210, 211, 216);
}

/* Each prototype keeps its own width, like Scratch's palette — never stretched to the column. */
.blocky-palette__section {
    align-items: flex-start;
    padding-bottom: 6px;
}

.blocky-palette__section-title {
    -unity-font-style: bold;
    margin: 10px 0 6px 10px;
    color: rgb(70, 72, 80);
}

/* Bottom margin leaves room for the tab hanging under each block. */
.blocky-palette__prototype {
    margin: 0 10px 14px 10px;
}

/* The table: an unbounded surface seen through this clipped viewport — drag empty space to move around,
   scroll to zoom. The canvas inside is moved and scaled with translate/scale, never resized. */
.blocky-ingame-canvas-viewport {
    flex-grow: 1;
    min-width: 120px;
    overflow: hidden;
    background-color: rgb(238, 239, 243);
}

/* How-to line along the bottom of the table; wraps rather than overflowing, and stays clear of the zoom buttons. */
.blocky-ingame-hint {
    position: absolute;
    left: 10px;
    right: 56px;
    bottom: 8px;
    font-size: 11px;
    white-space: normal;
    color: rgb(140, 142, 152);
}

.blocky-zoom-controls {
    position: absolute;
    right: 12px;
    bottom: 12px;
}

.blocky-zoom-button {
    width: 32px;
    height: 32px;
    margin: 3px 0;
    padding: 0;
    border-radius: 16px;
    border-width: 1px;
    border-color: rgb(200, 202, 210);
    background-color: rgb(255, 255, 255);
    color: rgb(70, 72, 80);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.blocky-zoom-button:hover {
    background-color: rgb(232, 236, 245);
}

.blocky-drag-ghost {
    opacity: 0.9;
}

.blocky-drag-chain {
    align-items: flex-start;
}

/* Sits in the root's right padding strip — the seam between the workspace and the live game view. */
.blocky-ingame-resize-handle {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(64, 68, 82);
}

.blocky-ingame-resize-handle:hover {
    background-color: rgb(110, 116, 136);
}

/* A condition about to drop into a slot: a glowing ring around the hole (drawn under the ghost). */
.blocky-drop-indicator.blocky-drop-indicator--slot {
    background-color: rgba(255, 236, 110, 0.35);
    border-width: 2px;
    border-color: rgb(255, 236, 110);
    border-radius: 12px;
}

/* The glow on the edge a dragged block is about to connect to. */
.blocky-drop-indicator {
    background-color: rgba(255, 236, 110, 0.85);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(255, 255, 255);
}
