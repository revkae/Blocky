/* Chrome for BlockyInGamePanel.
   One dark band (the header), then light surfaces all the way down — the Scratch/Blockly rule: the only
   saturated color on screen belongs to the blocks (blocky-base.uss / blocky-*.uss), plus the green Go and the
   red Stop. Everything else is built from the tokens below, so the whole workspace can be re-themed from one
   place. UI Toolkit has no box-shadow, so "floating" is a white surface with a hairline border. */

:root {
    --bk-header: rgb(26, 30, 42);
    --bk-header-soft: rgba(255, 255, 255, 0.10);
    --bk-surface: rgb(255, 255, 255);
    --bk-surface-2: rgb(246, 247, 251);
    --bk-surface-3: rgb(238, 240, 246);
    --bk-canvas: rgb(243, 245, 249);
    --bk-line: rgb(225, 228, 237);
    --bk-line-soft: rgb(236, 238, 244);
    --bk-ink: rgb(26, 31, 44);
    --bk-ink-2: rgb(92, 101, 120);
    --bk-ink-3: rgb(146, 154, 172);
    --bk-on-dark: rgb(240, 242, 248);
    --bk-on-dark-2: rgb(163, 171, 191);
    --bk-accent: rgb(76, 151, 255);
    --bk-accent-soft: rgb(232, 240, 255);
    --bk-go: rgb(58, 186, 106);
    --bk-go-hover: rgb(70, 202, 118);
    --bk-stop: rgb(233, 91, 82);
    --bk-stop-hover: rgb(244, 110, 101);
    --bk-warn: rgb(196, 132, 18);
    --bk-warn-soft: rgb(255, 246, 228);
    --bk-warn-line: rgb(243, 206, 134);
    --bk-hint-bg: rgb(255, 250, 233);
    --bk-hint-bg-hover: rgb(255, 245, 214);
    --bk-hint-ink: rgb(124, 92, 18);
    --bk-problem-bg: rgb(255, 238, 236);
    --bk-problem-bg-hover: rgb(255, 228, 225);
    --bk-problem-line: rgb(244, 168, 160);
    --bk-problem-ink: rgb(150, 44, 36);
    --bk-tip-bg: rgba(255, 255, 255, 0.72);
    --bk-paused-tray: rgba(255, 255, 255, 0.7);
    --bk-scroll-track: rgba(0, 0, 0, 0.03);
    --bk-scroll-thumb: rgba(26, 31, 44, 0.20);
    --bk-scroll-thumb-hover: rgba(26, 31, 44, 0.36);
}

.blocky-ingame-root {
    background-color: var(--bk-canvas);
}

/* ─── Header ─────────────────────────────────────────────────────────────────────────────────────────── */

.blocky-ingame-topbar {
    flex-shrink: 0; /* the root is a column: without this the body squeezes the bar below its height */
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 14px;
    overflow: hidden;
    background-color: var(--bk-header);
}

/* The wordmark: a rounded tile with a "B", the one place the accent color appears in the chrome. */
.blocky-ingame-mark {
    width: 24px;
    height: 24px;
    margin-right: 9px;
    border-radius: 7px;
    background-color: var(--bk-accent);
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.blocky-ingame-title {
    flex-shrink: 0;
    margin-right: 14px;
    font-size: 15px;
    color: var(--bk-on-dark);
    -unity-font-style: bold;
}

/* The object being edited, as a lit pill — a state, not a sentence. */
.blocky-ingame-status {
    flex-direction: row;
    align-items: center;
    flex-grow: 0; /* hugs the name — a spacer after it pushes the key hint to the far end */
    flex-shrink: 1;
    min-width: 0;
    max-width: 45%;
    height: 26px;
    padding: 0 11px 0 9px;
    border-radius: 13px;
    overflow: hidden;
    background-color: var(--bk-header-soft);
}

.blocky-ingame-status__dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    margin-right: 7px;
    border-radius: 4px;
    background-color: var(--bk-ink-3);
}

/* Lit once an object is being edited. */
.blocky-ingame-status--live .blocky-ingame-status__dot {
    background-color: var(--bk-go);
}

.blocky-ingame-status__label {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 12px;
    color: var(--bk-on-dark-2);
    -unity-text-align: middle-left;
}

.blocky-ingame-status--live .blocky-ingame-status__label {
    color: var(--bk-on-dark);
    -unity-font-style: bold;
}

/* Free / Simple: which kind of table you are working on. */
.blocky-ingame-mode {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 10px;
    padding: 3px;
    border-radius: 10px;
    background-color: var(--bk-header-soft);
}

.blocky-ingame-mode__button {
    height: 22px;
    margin: 0 1px;
    padding: 0 11px;
    border-radius: 7px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 11px;
    color: var(--bk-on-dark-2);
    -unity-font-style: bold;
    transition-property: background-color, color;
    transition-duration: 90ms;
}

.blocky-ingame-mode__button:hover {
    background-color: rgba(255, 255, 255, 0.10);
    color: var(--bk-on-dark);
}

.blocky-ingame-mode__button--active,
.blocky-ingame-mode__button--active:hover {
    background-color: var(--bk-accent);
    color: rgb(255, 255, 255);
}

/* The language buttons and the theme button: the same segmented pill as Free / Simple (.blocky-ingame-mode), set a little closer. */
.blocky-ingame-language,
.blocky-ingame-theme {
    margin-left: 8px;
}

.blocky-ingame-keyhint {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 12px;
}

/* A key cap, so "Tab" reads as a key and not as a word. */
.blocky-ingame-key {
    min-width: 30px;
    padding: 2px 7px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.22);
    background-color: rgba(255, 255, 255, 0.07);
    font-size: 10px;
    color: var(--bk-on-dark-2);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.blocky-ingame-keyhint__label {
    margin-left: 6px;
    font-size: 11px;
    color: rgb(124, 133, 154);
}

/* ─── Run bar ────────────────────────────────────────────────────────────────────────────────────────── */

/* White, with one hairline under it. Wraps onto a second line in a narrow workspace rather than pushing
   controls out of the panel. */
.blocky-runbar {
    flex-shrink: 0; /* keep every wrapped row — the body below takes what's left */
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 7px 12px;
    border-bottom-width: 1px;
    border-color: var(--bk-line);
    background-color: var(--bk-surface);
    transition-property: background-color;
    transition-duration: 120ms;
}

/* Paused (or between steps): a warm tint and a "Paused" flag, so it's obvious why nothing moves. */
.blocky-runbar--paused {
    background-color: var(--bk-warn-soft);
    border-color: var(--bk-warn-line);
}

/* Controls that belong together sit in one recessed tray, the way a transport bar groups play/stop. */
.blocky-runbar__group {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 8px;
    padding: 3px;
    border-radius: 11px;
    background-color: var(--bk-surface-2);
}

.blocky-runbar--paused .blocky-runbar__group {
    background-color: var(--bk-paused-tray);
}

.blocky-runbar__button {
    flex-shrink: 0;
    height: 28px;
    margin: 0 1px;
    padding: 0 13px;
    border-radius: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 12px;
    color: var(--bk-ink);
    -unity-font-style: bold;
    transition-property: background-color, color;
    transition-duration: 90ms;
}

.blocky-runbar__button:hover {
    background-color: var(--bk-surface-3);
}

.blocky-runbar__button:disabled {
    opacity: 0.35;
}

.blocky-runbar__go {
    background-color: var(--bk-go);
    color: rgb(255, 255, 255);
}

.blocky-runbar__go:hover {
    background-color: var(--bk-go-hover);
}

.blocky-runbar__stop {
    background-color: var(--bk-stop);
    color: rgb(255, 255, 255);
}

.blocky-runbar__stop:hover {
    background-color: var(--bk-stop-hover);
}

/* Step ◀ / Step ▶: square-ish, the glyph doing the work. */
.blocky-runbar__step {
    min-width: 40px;
    padding: 0 10px;
}

.blocky-runbar__flag {
    flex-shrink: 0;
    margin: 0 6px;
    padding: 3px 10px;
    border-radius: 9px;
    border-width: 1px;
    border-color: var(--bk-warn-line);
    background-color: var(--bk-surface);
    font-size: 11px;
    color: var(--bk-warn);
    -unity-font-style: bold;
}

/* Speed: a segmented control, the chosen one lit. */
.blocky-runbar__speed {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 0;
    padding: 3px;
    border-radius: 11px;
    background-color: var(--bk-surface-2);
}

.blocky-runbar__speed-label {
    margin: 0 7px 0 6px;
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--bk-ink-3);
    -unity-font-style: bold;
}

.blocky-runbar__speed-button {
    min-width: 30px;
    height: 24px;
    margin: 0 1px;
    padding: 0 6px;
    border-radius: 7px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 11px;
    color: var(--bk-ink-2);
    -unity-font-style: bold;
    transition-property: background-color, color;
    transition-duration: 90ms;
}

.blocky-runbar__speed-button:hover {
    background-color: var(--bk-surface-3);
}

.blocky-runbar__speed-button--active,
.blocky-runbar__speed-button--active:hover {
    background-color: var(--bk-accent);
    color: rgb(255, 255, 255);
}

/* ─── Body: rail · palette · table ───────────────────────────────────────────────────────────────────── */

.blocky-ingame-body {
    flex-direction: row;
    flex-grow: 1;
}

.blocky-ingame-tabrail {
    flex-shrink: 0; /* the body is a row: the rail keeps its width, the palette and the table share what is left */
    width: 78px; /* the longest category name in any language (Turkish "Değişkenler") fits on one line */
    padding: 8px 6px;
    border-right-width: 1px;
    border-color: var(--bk-line);
    background-color: var(--bk-surface-2);
}

/* Scratch-style tab: a colored dot with the category name underneath. */
.blocky-ingame-tab {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 56px;
    margin: 1px 0;
    padding: 4px 0;
    border-width: 0;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 90ms;
}

.blocky-ingame-tab:hover {
    background-color: var(--bk-surface-3);
}

.blocky-ingame-tab--active {
    background-color: var(--bk-surface);
    border-width: 1px;
    border-color: var(--bk-line);
}

.blocky-ingame-tab__dot {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.85);
}

.blocky-ingame-tab__label {
    margin-top: 5px;
    font-size: 10px;
    white-space: nowrap;
    color: var(--bk-ink-2);
    -unity-text-align: middle-center;
}

.blocky-ingame-tab--active .blocky-ingame-tab__label {
    color: var(--bk-ink);
    -unity-font-style: bold;
}

/* Shrinks with a narrow workspace instead of squeezing the table to nothing. Its width (flex-basis) is set
   from code and changed by dragging the seam on its right. */
.blocky-ingame-palette {
    flex-basis: 250px;
    flex-grow: 0; /* a ScrollView grows by default — the palette would split spare width with the table and ignore the seam */
    flex-shrink: 1;
    min-width: 140px;
    background-color: var(--bk-surface);
}

/* The seam between the palette and the table: drag it to resize the palette. */
.blocky-ingame-palette-handle {
    flex-shrink: 0;
    width: 7px;
    align-items: center;
    justify-content: center;
    border-left-width: 1px;
    border-color: var(--bk-line);
    background-color: var(--bk-surface-2);
    transition-property: background-color;
    transition-duration: 90ms;
}

.blocky-ingame-palette-handle:hover {
    background-color: var(--bk-accent-soft);
}

/* A grip, so the seam looks draggable instead of looking like a gap. */
.blocky-ingame-palette-handle__grip {
    width: 3px;
    height: 28px;
    border-radius: 2px;
    background-color: var(--bk-line);
}

.blocky-ingame-palette-handle:hover .blocky-ingame-palette-handle__grip {
    background-color: var(--bk-accent);
}

/* Each prototype keeps its own width, like Scratch's palette — never stretched to the column. */
.blocky-palette__section {
    align-items: flex-start;
    padding-bottom: 10px;
}

/* A caption, not a heading: small, spaced, with the category's dot in front of it. */
.blocky-palette__section-title {
    flex-direction: row;
    align-items: center;
    margin: 14px 0 8px 12px;
}

.blocky-palette__section-dot {
    width: 8px;
    height: 8px;
    margin-right: 7px;
    border-radius: 4px;
}

.blocky-palette__section-label {
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--bk-ink-3);
    -unity-font-style: bold;
}

/* Bottom margin leaves room for the tab hanging under each block. */
.blocky-palette__prototype {
    margin: 0 12px 14px 12px;
}

/* The table: an unbounded surface seen through this clipped viewport — drag empty space to move around,
   scroll to zoom. The canvas inside is moved and scaled with translate/scale, never resized; the dot grid is
   painted straight onto this element (BlockyInGamePanel.PaintGrid) so it follows the pan and the zoom. */
.blocky-ingame-canvas-viewport {
    flex-grow: 1;
    min-width: 120px;
    overflow: hidden;
    background-color: var(--bk-canvas);
    --bk-grid-dot: rgba(20, 31, 51, 0.14); /* read from code by the grid painter, so it is set on the viewport itself */
}

/* ─── Simple mode: one numbered column ───────────────────────────────────────────────────────────────── */

/* Every script flows down one column, indented past the gutter the line numbers sit in. The indent is a margin
   on the scripts rather than padding on the canvas, because an absolutely positioned child (the row layer) is
   laid out from the padding edge — with padding here, the numbers would start after their own gutter. */
.blocky-canvas--simple > .blocky-stack {
    margin: 10px 0 18px 44px;
}

.blocky-canvas__rows {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* One band per block, the height of the block and the width of the table, ruled off and numbered in the gutter:
   the script reads as the lines of a program, and the whole line is the block's area — click it to pick that
   block. Top and height are set from the measured layout; everything else is here.
   A band nested inside another is added after it, so it paints and picks on top of the one around it. */
.blocky-row {
    position: absolute;
    left: 0;
    right: 0;
    flex-direction: row;
    border-top-width: 1px;
    border-color: var(--bk-line-soft);
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 90ms;
}

.blocky-row:hover {
    background-color: rgba(76, 151, 255, 0.07);
}

/* The picked line, highlighted the way an editor highlights the line the caret is on. */
.blocky-row--selected {
    background-color: var(--bk-accent-soft);
}

/* The numbered strip down the left, with the rule that separates it from the code. */
.blocky-row__gutter {
    width: 36px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-color: var(--bk-line-soft);
}

.blocky-row__number {
    width: 26px;
    margin-top: 6px;
    font-size: 10px;
    color: var(--bk-ink-3);
    -unity-text-align: middle-right;
}

.blocky-row--selected .blocky-row__number {
    color: var(--bk-accent);
    -unity-font-style: bold;
}

/* ─── Floating table furniture ───────────────────────────────────────────────────────────────────────── */

/* Undo and, under it, Redo — top-right of the table. */
.blocky-table-tools {
    position: absolute;
    top: 12px;
    right: 12px;
    flex-direction: column;
    align-items: flex-end;
}

/* Variable watchers: Scratch's stage monitors, in the table's top-left corner where nothing else sits.
   Pinned above the blocks but never pickable, so a script underneath is still draggable. */
.blocky-watchers {
    position: absolute;
    top: 12px;
    left: 12px;
    flex-direction: column;
    align-items: flex-start;
    background-color: var(--bk-surface);
    border-color: var(--bk-line);
    border-width: 1px;
    border-radius: 8px;
    padding: 6px 4px 6px 8px;
}

.blocky-watchers__row {
    font-size: 11px;
    color: var(--bk-ink);
    -unity-font-style: bold;
    padding: 2px 8px 2px 0;
}


.blocky-table-tools__button {
    height: 30px;
    margin-top: 6px;
    padding: 0 14px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--bk-line);
    background-color: var(--bk-surface);
    font-size: 12px;
    color: var(--bk-ink-2);
    -unity-font-style: bold;
    transition-property: background-color, color;
    transition-duration: 90ms;
}

.blocky-table-tools__button:hover {
    background-color: var(--bk-accent-soft);
    color: var(--bk-accent);
}

.blocky-table-tools__button:disabled {
    opacity: 0.4;
}

/* The level's block limit, "Blocks 3 / 5": a chip above Undo, amber when full, red when over. */
.blocky-limit {
    height: 26px;
    padding: 0 12px;
    border-radius: 13px;
    border-width: 1px;
    border-color: var(--bk-line);
    background-color: var(--bk-surface);
    font-size: 12px;
    color: var(--bk-ink-2);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.blocky-limit--full {
    border-color: var(--bk-warn-line);
    background-color: var(--bk-warn-soft);
    color: var(--bk-warn);
}

.blocky-limit--over {
    border-color: var(--bk-stop);
    background-color: var(--bk-stop);
    color: rgb(255, 255, 255);
}

/* A palette block that can't be added now — the block limit is reached. Still visible, so the learner sees what they'd get. */
.blocky-palette__prototype--unavailable {
    opacity: 0.35;
}

/* One card, bottom-right: zoom in, zoom out, fit, and what the zoom currently is. */
.blocky-zoom-controls {
    position: absolute;
    right: 12px;
    bottom: 12px;
    align-items: center;
    padding: 4px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--bk-line);
    background-color: var(--bk-surface);
}

.blocky-zoom-button {
    width: 30px;
    height: 30px;
    margin: 1px 0;
    padding: 0;
    border-radius: 9px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    font-size: 15px;
    color: var(--bk-ink-2);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, color;
    transition-duration: 90ms;
}

.blocky-zoom-button:hover {
    background-color: var(--bk-accent-soft);
    color: var(--bk-accent);
}

.blocky-zoom-level {
    margin: 2px 0 1px 0;
    font-size: 9px;
    color: var(--bk-ink-3);
    -unity-text-align: middle-center;
}

/* ─── Footer: advice, then the tips line ─────────────────────────────────────────────────────────────── */

.blocky-table-footer {
    position: absolute;
    left: 12px;
    right: 58px;
    bottom: 10px;
    align-items: flex-start;
}

.blocky-advice-list {
    margin-bottom: 8px;
    align-items: flex-start;
}

/* One advice message; click it to select the block it's about. */
.blocky-advice {
    white-space: normal;
    -unity-text-align: middle-left;
    margin: 0 0 4px 0;
    padding: 7px 12px;
    border-radius: 10px;
    border-width: 1px;
    font-size: 12px;
    transition-property: background-color;
    transition-duration: 90ms;
}

.blocky-advice--hint {
    background-color: var(--bk-hint-bg);
    border-color: var(--bk-warn-line);
    color: var(--bk-hint-ink);
}

.blocky-advice--hint:hover {
    background-color: var(--bk-hint-bg-hover);
}

.blocky-advice--problem {
    background-color: var(--bk-problem-bg);
    border-color: var(--bk-problem-line);
    color: var(--bk-problem-ink);
}

.blocky-advice--problem:hover {
    background-color: var(--bk-problem-bg-hover);
}

.blocky-advice-more {
    margin-left: 2px;
    font-size: 11px;
    color: var(--bk-ink-3);
}

/* The tips line: a few chips and a "?" that opens the full list, instead of one long sentence. */
.blocky-tips {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.blocky-tips__toggle {
    width: 22px;
    height: 22px;
    margin: 0 7px 0 0;
    padding: 0;
    border-radius: 11px;
    border-width: 1px;
    border-color: var(--bk-line);
    background-color: var(--bk-surface);
    font-size: 11px;
    color: var(--bk-ink-2);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color, color;
    transition-duration: 90ms;
}

.blocky-tips__toggle:hover,
.blocky-tips__toggle--open {
    background-color: var(--bk-accent);
    border-color: var(--bk-accent);
    color: rgb(255, 255, 255);
}

.blocky-tip {
    margin: 2px 5px 2px 0;
    padding: 3px 9px;
    border-radius: 9px;
    border-width: 1px;
    border-color: var(--bk-line-soft);
    background-color: var(--bk-tip-bg);
    font-size: 10px;
    color: var(--bk-ink-2);
}

/* The full list, opened from the "?". */
.blocky-tips-card {
    margin-bottom: 8px;
    padding: 10px 14px;
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--bk-line);
    background-color: var(--bk-surface);
}

.blocky-tips-card__line {
    margin: 2px 0;
    font-size: 11px;
    white-space: normal;
    color: var(--bk-ink-2);
}

/* ─── Drag, selection, seams ─────────────────────────────────────────────────────────────────────────── */

.blocky-drag-ghost {
    opacity: 0.92;
}

.blocky-drag-chain {
    align-items: flex-start;
}

/* The box dragged over empty table to select several blocks at once. */
.blocky-selection-box {
    position: absolute;
    background-color: rgba(76, 151, 255, 0.10);
    border-width: 1px;
    border-color: var(--bk-accent);
    border-radius: 4px;
}

/* Sits in the root's right padding strip — the seam between the workspace and the live game view. */
.blocky-ingame-resize-handle {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--bk-surface-3);
    transition-property: background-color;
    transition-duration: 90ms;
}

.blocky-ingame-resize-handle:hover {
    background-color: var(--bk-accent);
}

.blocky-ingame-resize-handle__grip {
    width: 3px;
    height: 34px;
    border-radius: 2px;
    background-color: var(--bk-ink-3);
}

.blocky-ingame-resize-handle:hover .blocky-ingame-resize-handle__grip {
    background-color: rgb(255, 255, 255);
}

/* A condition about to drop into a slot: a glowing ring around the hole (drawn under the ghost). */
.blocky-drop-indicator.blocky-drop-indicator--slot {
    background-color: rgba(255, 236, 110, 0.35);
    border-width: 2px;
    border-color: rgb(255, 236, 110);
    border-radius: 12px;
}

/* The glow on the edge a dragged block is about to connect to — and, on the strict column, the bar marking the
   line it will go in on. */
.blocky-drop-indicator {
    background-color: rgba(255, 236, 110, 0.85);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(255, 255, 255);
}

/* The bar on the line a chain will go in on. Blue, not the snap glow's yellow: it is drawn along the edge of a
   block, and the blocks themselves are warm — a yellow bar on an orange block is invisible. */
.blocky-drop-indicator.blocky-drop-indicator--row {
    background-color: var(--bk-accent);
    border-color: rgb(255, 255, 255);
    border-radius: 3px;
}

/* Letting go here puts the chain in place of the block underneath: the whole block is ringed rather than one edge. */
.blocky-drop-indicator.blocky-drop-indicator--replace {
    background-color: rgba(76, 151, 255, 0.22);
    border-width: 2px;
    border-color: var(--bk-accent);
    border-radius: 10px;
}

/* "Above" / "Replace" / "Below": what letting go right now would do, said in a word. */
.blocky-drop-indicator__caption {
    position: absolute;
    right: 6px;
    top: -9px;
    padding: 2px 8px;
    border-radius: 8px;
    background-color: var(--bk-header);
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--bk-on-dark);
}

.blocky-drop-indicator--replace .blocky-drop-indicator__caption {
    top: 6px;
}

/* ─── Slim scrollbars ────────────────────────────────────────────────────────────────────────────────── */

/* A thin rounded thumb and no arrow buttons, instead of Unity's wide default with arrows. */
.blocky-ingame-root .unity-scroller--vertical {
    width: 8px;
    min-width: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.blocky-ingame-root .unity-scroller--horizontal {
    height: 8px;
    min-height: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.blocky-ingame-root .unity-scroller__low-button,
.blocky-ingame-root .unity-scroller__high-button {
    display: none;
}

.blocky-ingame-root .unity-scroller .unity-scroller__slider {
    margin: 0;
}

.blocky-ingame-root .unity-scroller .unity-base-slider__tracker {
    border-width: 0;
    border-radius: 4px;
    background-color: var(--bk-scroll-track);
}

.blocky-ingame-root .unity-scroller .unity-base-slider__dragger {
    border-width: 0;
    border-radius: 3px;
    background-color: var(--bk-scroll-thumb);
}

.blocky-ingame-root .unity-scroller .unity-base-slider__dragger:hover {
    background-color: var(--bk-scroll-thumb-hover);
}

.blocky-ingame-root .unity-scroller--vertical .unity-base-slider__dragger {
    left: 1px;
    width: 6px;
}

/* Unity's track is wider than the whole slim bar (measured 24px) — keep it inside the 8px. */
.blocky-ingame-root .unity-scroller--vertical .unity-base-slider__tracker {
    left: 0;
    width: 8px;
}

.blocky-ingame-root .unity-scroller--horizontal .unity-base-slider__dragger {
    top: 1px;
    height: 6px;
}

.blocky-ingame-root .unity-scroller--horizontal .unity-base-slider__tracker {
    top: 0;
    height: 8px;
}

/* ─── Themes ─────────────────────────────────────────────────────────────────────────────────────────── */

/* The workspace root carries one of blocky-theme--light / --dark / --contrast (BlockyInGamePanel.Theme). Light is
   the tokens at the top of this sheet. The others redefine the tokens on the root, which every element below
   inherits — plus the few values code reads off an element itself (the grid's dots, a block's fill and
   outline), which have to be set on that element. */

.blocky-theme--dark {
    --bk-header: rgb(14, 16, 22);
    --bk-header-soft: rgba(255, 255, 255, 0.08);
    --bk-surface: rgb(33, 37, 48);
    --bk-surface-2: rgb(27, 30, 40);
    --bk-surface-3: rgb(41, 46, 59);
    --bk-canvas: rgb(22, 25, 33);
    --bk-line: rgb(56, 62, 79);
    --bk-line-soft: rgb(45, 50, 64);
    --bk-ink: rgb(232, 235, 243);
    --bk-ink-2: rgb(168, 176, 196);
    --bk-ink-3: rgb(121, 130, 151);
    --bk-accent: rgb(96, 165, 255);
    --bk-accent-soft: rgb(36, 52, 82);
    --bk-warn: rgb(240, 186, 80);
    --bk-warn-soft: rgb(58, 48, 26);
    --bk-warn-line: rgb(120, 96, 44);
    --bk-hint-bg: rgb(52, 45, 26);
    --bk-hint-bg-hover: rgb(64, 55, 30);
    --bk-hint-ink: rgb(245, 214, 140);
    --bk-problem-bg: rgb(64, 32, 32);
    --bk-problem-bg-hover: rgb(78, 38, 38);
    --bk-problem-line: rgb(140, 70, 64);
    --bk-problem-ink: rgb(255, 184, 174);
    --bk-tip-bg: rgba(255, 255, 255, 0.05);
    --bk-paused-tray: rgba(255, 255, 255, 0.06);
    --bk-scroll-track: rgba(255, 255, 255, 0.03);
    --bk-scroll-thumb: rgba(255, 255, 255, 0.18);
    --bk-scroll-thumb-hover: rgba(255, 255, 255, 0.32);
}

.blocky-theme--dark .blocky-ingame-canvas-viewport {
    --bk-grid-dot: rgba(255, 255, 255, 0.10);
}

/* High contrast: black on white, strong lines, and Scratch's high-contrast block colors — lighter fills with black
   text and a black outline — so every block reads without relying on color. */
.blocky-theme--contrast {
    --bk-header: rgb(0, 0, 0);
    --bk-header-soft: rgba(255, 255, 255, 0.18);
    --bk-surface: rgb(255, 255, 255);
    --bk-surface-2: rgb(255, 255, 255);
    --bk-surface-3: rgb(232, 232, 232);
    --bk-canvas: rgb(255, 255, 255);
    --bk-line: rgb(0, 0, 0);
    --bk-line-soft: rgb(96, 96, 96);
    --bk-ink: rgb(0, 0, 0);
    --bk-ink-2: rgb(0, 0, 0);
    --bk-ink-3: rgb(56, 56, 56);
    --bk-on-dark: rgb(255, 255, 255);
    --bk-on-dark-2: rgb(235, 235, 235);
    --bk-accent: rgb(0, 76, 204);
    --bk-accent-soft: rgb(214, 228, 255);
    --bk-go: rgb(0, 122, 54);
    --bk-go-hover: rgb(0, 142, 64);
    --bk-stop: rgb(190, 0, 0);
    --bk-stop-hover: rgb(214, 18, 18);
    --bk-warn: rgb(112, 70, 0);
    --bk-warn-soft: rgb(255, 238, 190);
    --bk-warn-line: rgb(0, 0, 0);
    --bk-hint-bg: rgb(255, 238, 190);
    --bk-hint-bg-hover: rgb(255, 226, 156);
    --bk-hint-ink: rgb(0, 0, 0);
    --bk-problem-bg: rgb(255, 214, 214);
    --bk-problem-bg-hover: rgb(255, 194, 194);
    --bk-problem-line: rgb(0, 0, 0);
    --bk-problem-ink: rgb(0, 0, 0);
    --bk-tip-bg: rgb(255, 255, 255);
    --bk-paused-tray: rgb(255, 255, 255);
    --bk-scroll-track: rgba(0, 0, 0, 0.06);
    --bk-scroll-thumb: rgba(0, 0, 0, 0.55);
    --bk-scroll-thumb-hover: rgba(0, 0, 0, 0.8);
    --blocky-color-motion: rgb(128, 181, 255);
    --blocky-color-looks: rgb(204, 179, 255);
    --blocky-color-control: rgb(255, 190, 76);
    --blocky-color-event: rgb(255, 217, 102);
    --blocky-color-conditions: rgb(133, 196, 224);
    --blocky-color-sensing: rgb(133, 196, 224);
    --blocky-color-operators: rgb(126, 206, 126);
    --blocky-color-sound: rgb(225, 157, 225);
    --blocky-color-variables: rgb(255, 165, 76);
    --blocky-color-lists: rgb(255, 153, 102);
    --blocky-color-myblocks: rgb(255, 153, 170);
}

.blocky-theme--contrast .blocky-ingame-canvas-viewport {
    --bk-grid-dot: rgba(0, 0, 0, 0.28);
}

.blocky-theme--contrast .blocky-shaped {
    --blocky-stroke: rgb(0, 0, 0);
    --blocky-selected-stroke: rgb(0, 76, 204);
}

.blocky-theme--contrast .blocky-shaped Label,
.blocky-theme--contrast .blocky-param-field > .unity-base-field__label {
    color: rgb(0, 0, 0);
}

.blocky-theme--contrast .blocky-block--category-motion { --blocky-fill: rgb(128, 181, 255); }
.blocky-theme--contrast .blocky-block--category-looks { --blocky-fill: rgb(204, 179, 255); }
.blocky-theme--contrast .blocky-block--category-control { --blocky-fill: rgb(255, 190, 76); }
.blocky-theme--contrast .blocky-block--category-event { --blocky-fill: rgb(255, 217, 102); }
.blocky-theme--contrast .blocky-block--category-conditions { --blocky-fill: rgb(133, 196, 224); }
.blocky-theme--contrast .blocky-block--category-sensing { --blocky-fill: rgb(133, 196, 224); }
.blocky-theme--contrast .blocky-block--category-operators { --blocky-fill: rgb(126, 206, 126); }
.blocky-theme--contrast .blocky-block--category-sound { --blocky-fill: rgb(225, 157, 225); }
.blocky-theme--contrast .blocky-block--category-variables { --blocky-fill: rgb(255, 165, 76); }
.blocky-theme--contrast .blocky-block--category-lists { --blocky-fill: rgb(255, 153, 102); }
.blocky-theme--contrast .blocky-block--category-myblocks { --blocky-fill: rgb(255, 153, 170); }
