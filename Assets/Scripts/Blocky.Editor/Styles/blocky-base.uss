:root {
    --blocky-color-motion: rgb(76, 151, 255);
    --blocky-color-looks: rgb(153, 102, 204);
    --blocky-color-control: rgb(255, 171, 25);
    --blocky-color-event: rgb(255, 191, 0);
    --blocky-color-conditions: rgb(92, 177, 214);
    --blocky-color-sensing: rgb(92, 177, 214);
    --blocky-color-operators: rgb(89, 192, 89);
    --blocky-color-sound: rgb(207, 99, 207);
    --blocky-color-variables: rgb(255, 140, 26);
    --blocky-color-error: rgb(190, 60, 60);
    --blocky-color-neutral: rgb(90, 90, 90);
}

.blocky-stack {
    margin: 0;
    align-items: flex-start;
}

.blocky-stack__sequence {
    margin-left: 0;
    align-items: flex-start;
}

/* Plain rectangle look — only unknown/error blocks still use it. */
.blocky-block {
    background-color: var(--blocky-color-neutral);
    border-radius: 6px;
    padding: 4px 8px;
    margin: 2px 0;
}

/* Shaped blocks draw their own silhouette (BlockOutline): no rectangle, no spacing — each block's tab sits in
   the next block's notch. Two classes so this beats every single-class category rule whatever the sheet order. */
.blocky-block.blocky-shaped {
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    padding: 0;
    margin: 0;
    min-width: 64px;
}

.blocky-block--shape-trigger.blocky-shaped,
.blocky-block--shape-cblock.blocky-shaped,
.blocky-block--shape-cap.blocky-shaped {
    min-width: 110px;
}

.blocky-block__header {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    padding: 6px 10px 4px 10px;
}

/* The categories added after the first four. Kept in this sheet rather than each in its own file so the
   scene's stylesheet list and the Editor window's sheet list need no new entry. Sensing shares Scratch's
   light blue with the older Conditions category, which no block uses any more. */
.blocky-block--category-conditions {
    background-color: var(--blocky-color-conditions);
    --blocky-fill: rgb(92, 177, 214);
}

.blocky-block--category-sensing {
    background-color: var(--blocky-color-sensing);
    --blocky-fill: rgb(92, 177, 214);
}

.blocky-block--category-operators {
    background-color: var(--blocky-color-operators);
    --blocky-fill: rgb(89, 192, 89);
}

.blocky-block--category-sound {
    background-color: var(--blocky-color-sound);
    --blocky-fill: rgb(207, 99, 207);
}

.blocky-block--category-variables {
    background-color: var(--blocky-color-variables);
    --blocky-fill: rgb(255, 140, 26);
}

/* Condition block: a hexagon, shorter than a stack block, with room for the pointed ends. */
.blocky-block--shape-boolean.blocky-shaped {
    min-width: 0;
}

.blocky-block--shape-boolean > .blocky-block__header {
    min-height: 24px;
    padding: 3px 14px;
}

/* The hexagonal hole a condition drops into. Two classes so this beats the owner's category rule, whose
   rectangular background-color would otherwise paint behind the hexagon. */
.blocky-param-field.blocky-condition-slot {
    background-color: rgba(0, 0, 0, 0);
    min-width: 44px;
    min-height: 24px;
}

/* Reporter block: Scratch's round block. Same compact header as a condition; the pill is painted, so the
   element itself stays transparent. */
.blocky-block--shape-reporter.blocky-shaped {
    min-width: 0;
}

.blocky-block--shape-reporter > .blocky-block__header {
    min-height: 22px;
    padding: 2px 10px;
}

/* A value input: just a wrapper around the param's own control, or around the reporter dropped onto it. It
   carries no padding of its own — the control inside already has blocky-param-field. */
.blocky-value-slot {
    flex-direction: row;
    align-items: center;
}

/* Room for the hat's rounded bump above the text. */
.blocky-block--shape-trigger > .blocky-block__header {
    padding-top: 20px;
}

.blocky-shaped Label {
    color: rgb(255, 255, 255);
    font-size: 12px;
}

/* A C-block's mouth: indented by the spine, children keep their own widths. */
.blocky-block__body-slot {
    margin-left: 16px;
    min-height: 24px;
    align-items: flex-start;
}

.blocky-block__arm {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    padding: 0 10px;
}

.blocky-block__footer {
    height: 18px;
}

/* Advice badge pinned to a block's top-right corner: "!" = this script won't run, "?" = a hint. The table
   (ProgramCanvasView.SetAdvice) adds them; the message itself is listed under the table. */
.blocky-advice-badge {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 18px;
    height: 18px;
    margin: 0;
    padding: 0;
    border-radius: 9px;
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.blocky-advice-badge--hint {
    background-color: rgb(240, 180, 30);
}

.blocky-advice-badge--problem {
    background-color: rgb(214, 60, 50);
}

.blocky-block--error {
    background-color: var(--blocky-color-error);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
}

/* Inputs: the key as small white text, the value in a white oval — Scratch's reporter-slot look. */
.blocky-param-field {
    flex-direction: row;
    align-items: center;
    margin: 0 0 0 6px;
    min-width: 0;
}

.blocky-param-field > .unity-base-field__label {
    min-width: 0;
    margin: 0 4px 0 0;
    padding: 0;
    font-size: 11px;
    color: rgb(255, 255, 255);
}

.blocky-param-field .unity-base-field__input {
    background-color: rgb(255, 255, 255);
    border-width: 0;
    border-radius: 10px;
    min-width: 34px;
    padding: 1px 6px;
    color: rgb(70, 70, 80);
}

/* Dropdowns carry their own text/arrow colors from the theme, which beat the inherited color above. */
.blocky-param-field .unity-base-popup-field__text,
.blocky-param-field .unity-base-popup-field__arrow {
    color: rgb(70, 70, 80);
    -unity-background-image-tint-color: rgb(70, 70, 80);
}

.blocky-param-chip__key {
    font-size: 11px;
    margin-right: 4px;
}

.blocky-shaped .blocky-param-chip {
    background-color: rgb(255, 255, 255);
    border-radius: 10px;
    min-width: 24px;
    padding: 1px 7px;
    color: rgb(70, 70, 80);
    font-size: 11px;
    -unity-text-align: middle-center;
}

/* Editor window (button mode) affordances. */
.blocky-block__delete, .blocky-stack__delete {
    margin-left: 8px;
}

.blocky-block__add-container {
    position: relative;
    margin: 2px 0 2px 16px;
}

.blocky-block__add-button {
    align-self: flex-start;
}

.blocky-picker-popup {
    position: absolute;
    top: 100%;
    left: 0;
    background-color: rgb(45, 45, 45);
    border-width: 1px;
    border-color: rgb(20, 20, 20);
    border-radius: 4px;
    padding: 2px;
    min-width: 160px;
}

.blocky-picker-popup__item {
    padding: 3px 6px;
}

.blocky-picker-popup__item:hover {
    background-color: rgb(70, 70, 70);
}
